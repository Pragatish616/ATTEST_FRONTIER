# --- Supabase (required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# --- LLM providers (at least ONE is required) ---
# Providers are tried in order: anthropic -> groq -> gemini. A provider with
# no key is skipped entirely, so leaving ANTHROPIC_API_KEY blank and setting
# only GEMINI_API_KEY makes Gemini the effective primary (free-tier demo).
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Model tier overrides (optional — sensible defaults are set in code) ---
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_JUDGE_MODEL=claude-sonnet-5
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_JUDGE_MODEL=llama-3.3-70b-versatile
# GEMINI_FAST_MODEL=gemini-2.0-flash
# GEMINI_JUDGE_MODEL=gemini-2.0-flash

# --- Independent web search (A3) ---
TAVILY_API_KEY=

# --- Local corpus store (A5 demo) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# --- API hardening (attest/api/security.py) ---
# Shared bearer token for the public API. LEAVE BLANK for local development and
# for the dashboard/Opal tracks — blank disables auth entirely and keeps the
# frozen §5.2 contract open. SET IT IN PRODUCTION: without it, /v1/observe is
# reachable by anyone who finds the URL and every request spends LLM credit.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The SDK sends this as `Authorization: Bearer <key>` via attest.init(api_key=...).
ATTEST_API_KEY=

# Comma-separated browser origins allowed to call the API (the dashboard's
# Vercel URL in production). Defaults to "*", which also forces
# allow_credentials off, since "*" plus credentials is spec-invalid.
CORS_ALLOW_ORIGINS=*

# Server-side ceiling on the caller-supplied AttestConfig.budget_usd. The
# request body can ask for any budget; this is what actually caps our spend.
MAX_BUDGET_USD=0.25

# Edge limits. The stream endpoint is exempt from rate limiting (the dashboard
# holds one long-lived SSE connection per run).
MAX_REQUEST_BYTES=524288
RATE_LIMIT_READ_PER_MINUTE=120
RATE_LIMIT_WRITE_PER_MINUTE=20
